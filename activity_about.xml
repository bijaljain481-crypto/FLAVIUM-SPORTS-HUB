<?xml version="1.0" encoding="utf-8"?>
<!-- About Activity Layout with WebView and offline fallback container -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:orientation="vertical">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/splash_gradient"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About Flaviums"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="NMIMS MPSTME Official Sports Portal"
            android:textColor="#F59E0B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Offline Fallback Container (Displayed when internet is unavailable) -->
    <LinearLayout
        android:id="@+id/llFallbackContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏛️ NMIMS MPSTME • Flaviums"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/dividerColor" />

            <TextView
                android:id="@+id/tvAboutFlaviumsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:text="Flaviums is the prestigious annual inter-department engineering sports festival of NMIMS Mukesh Patel School of Technology Management and Engineering (MPSTME), Mumbai.\n\nFeaturing 14 competitive disciplines across indoor and outdoor venues, Flaviums fosters athletic excellence, leadership, and camaraderie among student engineers across MBA Tech CE, BTech CE, CE, IT, AIML, and CSDS departments.\n\nOrganized annually by the MPSTME Sports Committee."
                android:textColor="@color/textPrimary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="📍 SVKM\'s NMIMS MPSTME, Vile Parle West, Mumbai, Maharashtra 400056"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- WebView for loading college portal -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
