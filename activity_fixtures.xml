<?xml version="1.0" encoding="utf-8"?>
<!-- Fixtures Activity Layout with SearchView, Sport Spinner, Date Picker button, and Matches ScrollView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:orientation="vertical">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/splash_gradient"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fixtures &amp; Matches"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="All Scheduled Inter-Branch Sports Fixtures"
            android:textColor="#F59E0B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Top SearchView to filter by team or sport name -->
    <SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/row_background"
        android:iconifiedByDefault="false"
        android:queryHint="Search team or sport..." />

    <!-- Filter Bar: Spinner for Sport & DatePickerDialog Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Sport Filter Spinner -->
        <Spinner
            android:id="@+id/spinnerSportFilter"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/row_background" />

        <!-- DatePicker Dialog Trigger Button -->
        <Button
            android:id="@+id/btnPickDate"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_primary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="📅 Date"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <!-- Clear Date Filter Button -->
        <Button
            android:id="@+id/btnClearDate"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/row_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Clear"
            android:textColor="@color/textPrimary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Active Filter Status Indicator -->
    <TextView
        android:id="@+id/tvFilterSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:text="Showing all matches"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />

    <!-- ScrollView for Match Rows -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- "No matches found" message -->
            <TextView
                android:id="@+id/tvNoMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="No matches found matching your filters."
                android:textColor="@color/textSecondary"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- Dynamic Matches Container populated via Java addView() in for-loop -->
            <LinearLayout
                android:id="@+id/llMatchesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
